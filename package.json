{
  "name": "super-quadras-oficial",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3100",
    "build": "npm run validate:content && next build",
    "start": "next start --port 3100",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/prepare-assets.mjs && node scripts/prepare-solution-illustrations.mjs && tsx scripts/prepare-social.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "format": "prettier --write src scripts e2e docs *.ts *.json README.md",
    "format:check": "prettier --check src scripts e2e docs *.ts *.json README.md",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "potrace": "2.1.8",
    "prettier": "3.9.9",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "overrides": {
    "sharp": "$sharp",
    "phin": "3.7.1"
  },
  "engines": {
    "node": ">=22.14.0 <25"
  }
}
